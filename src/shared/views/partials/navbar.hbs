<header class="bg-white border-b border-slate-200 sticky top-0 z-50 shadow-[0_1px_3px_rgba(15,23,42,0.04)]">
  <div class="container mx-auto px-4 max-w-7xl h-16 flex items-center justify-between gap-4">
    
    <!-- Left: Brand Logo -->
    <div class="flex items-center gap-6">
      <a href="/" class="flex items-center gap-2.5 group text-decoration-none">
        <div class="w-9 h-9 bg-slate-900 text-white rounded-lg flex items-center justify-center font-black text-sm tracking-tighter group-hover:bg-emerald-700 transition-colors shadow-sm relative">
          TL
          <span class="absolute -top-0.5 -right-0.5 w-2.5 h-2.5 bg-emerald-500 rounded-full border-2 border-white"></span>
        </div>
        <div>
          <div class="font-black text-slate-900 tracking-tight leading-none text-lg group-hover:text-emerald-700 transition-colors">TrueLabel</div>
          <div class="text-[10px] text-slate-500 font-bold uppercase tracking-wider">Food Safety & Quality</div>
        </div>
      </a>

      <!-- Desktop Primary Navigation -->
      <nav class="hidden lg:flex items-center gap-1 text-xs font-bold text-slate-600">
        <a href="/" class="px-3 py-2 rounded-md hover:text-slate-900 hover:bg-slate-100 transition-colors {{#if (eq activeNav 'home')}}text-emerald-700 bg-emerald-50/70{{/if}}">
          Home
        </a>
        <a href="/catalog" class="px-3 py-2 rounded-md hover:text-slate-900 hover:bg-slate-100 transition-colors {{#if (eq activeNav 'catalog')}}text-emerald-700 bg-emerald-50/70{{/if}}">
          Food Catalog
        </a>
        
        <!-- Safety & Compliance Group -->
        <a href="/safety/documents" class="px-3 py-2 rounded-md hover:text-slate-900 hover:bg-slate-100 transition-colors {{#if (eq activeNav 'documents')}}text-emerald-700 bg-emerald-50/70{{/if}}">
          Safety Documents
        </a>
        <a href="/safety/licence/verify" class="px-3 py-2 rounded-md hover:text-slate-900 hover:bg-slate-100 transition-colors {{#if (eq activeNav 'verify')}}text-emerald-700 bg-emerald-50/70{{/if}}">
          Verify Licence
        </a>

        <!-- Personal Health / Dietary Profile -->
        {{#if user}}
          <a href="/personal/profile" class="px-3 py-2 rounded-md hover:text-emerald-700 hover:bg-emerald-50 transition-colors flex items-center gap-1.5 {{#if (eq activeNav 'profile')}}text-emerald-700 bg-emerald-50{{else}}text-slate-700{{/if}}">
            <span class="w-1.5 h-1.5 rounded-full bg-emerald-600"></span>
            Dietary Profile
          </a>
        {{/if}}
      </nav>
    </div>

    <!-- Right Controls: Role Actions, Viva Role Switcher, Auth -->
    <div class="hidden md:flex items-center gap-3">
      
      <!-- Role Management Quick Actions (Only for Manufacturer / Inspector / Admin) -->
      {{#if (or (eq user.role "manufacturer") (eq user.role "admin"))}}
        <div class="flex items-center gap-1.5 bg-emerald-50/80 border border-emerald-200/80 rounded-lg p-1">
          <a href="/catalog/manage/create" class="px-2.5 py-1 text-[11px] font-bold text-emerald-800 hover:bg-emerald-100/80 rounded transition-colors flex items-center gap-1">
            <svg class="w-3.5 h-3.5 text-emerald-700" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M12 4v16m8-8H4"></path></svg>
            Add Food
          </a>
          <a href="/safety/documents/upload" class="px-2.5 py-1 text-[11px] font-bold text-emerald-800 hover:bg-emerald-100/80 rounded transition-colors flex items-center gap-1">
            <svg class="w-3.5 h-3.5 text-emerald-700" fill="none" stroke="currentColor" viewBox="0 0 24 24"><path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 16v1a3 3 0 003 3h10a3 3 0 003-3v-1m-4-8l-4-4m0 0L8 8m4-4v12"></path></svg>
            Upload Cert
          </a>
        </div>
      {{/if}}

      {{#if (eq user.role "inspector")}}
        <div class="flex items-center gap-1.5 bg-amber-50/80 border border-amber-200/80 rounded-lg p-1">
          <a href="/safety/documents?status=pending" class="px-2.5 py-1 text-[11px] font-bold text-amber-900 hover:bg-amber-100/80 rounded transition-colors flex items-center gap-1">
            <span class="w-2 h-2 rounded-full bg-amber-600 animate-pulse"></span>
            Review Queue
          </a>
        </div>
      {{/if}}

      <!-- Viva Demo Role Switcher -->
      <div class="flex items-center bg-slate-100 rounded-lg p-1 border border-slate-200 text-[11px]">
        <span class="text-slate-400 font-bold px-1.5 tracking-tight uppercase text-[10px]">Role:</span>
        <a href="/auth/switch-role/consumer" title="Switch to Consumer" class="px-2 py-0.5 rounded font-bold transition-all {{#if (eq user.role 'consumer')}}bg-white text-slate-900 shadow-sm{{else}}text-slate-600 hover:text-slate-900{{/if}}">Consumer</a>
        <a href="/auth/switch-role/manufacturer" title="Switch to Manufacturer" class="px-2 py-0.5 rounded font-bold transition-all {{#if (eq user.role 'manufacturer')}}bg-emerald-700 text-white shadow-sm{{else}}text-slate-600 hover:text-slate-900{{/if}}">Mfg</a>
        <a href="/auth/switch-role/inspector" title="Switch to Inspector" class="px-2 py-0.5 rounded font-bold transition-all {{#if (eq user.role 'inspector')}}bg-amber-600 text-white shadow-sm{{else}}text-slate-600 hover:text-slate-900{{/if}}">Inspector</a>
        <a href="/auth/switch-role/admin" title="Switch to Admin" class="px-2 py-0.5 rounded font-bold transition-all {{#if (eq user.role 'admin')}}bg-slate-900 text-white shadow-sm{{else}}text-slate-600 hover:text-slate-900{{/if}}">Admin</a>
      </div>

      <!-- User Account & Auth Actions -->
      {{#if user}}
        <div class="flex items-center gap-2 pl-1 border-l border-slate-200">
          <div class="w-8 h-8 rounded-full bg-slate-800 text-white flex items-center justify-center font-black text-xs uppercase" title="{{user.name}} ({{user.role}})">
            {{#if user.name}}{{user.name.[0]}}{{else}}U{{/if}}
          </div>
          <form action="/auth/logout" method="POST" class="inline">
            <button type="submit" class="text-xs font-bold px-2.5 py-1.5 rounded border border-slate-300 text-slate-700 hover:bg-slate-100 transition-colors">
              Sign Out
            </button>
          </form>
        </div>
      {{else}}
        <div class="flex items-center gap-2 pl-1 border-l border-slate-200">
          <a href="/auth/login" class="text-xs font-bold px-3 py-1.5 rounded-lg bg-slate-900 text-white hover:bg-slate-800 transition-colors shadow-sm">
            Sign In
          </a>
        </div>
      {{/if}}
    </div>

    <!-- Mobile Hamburger Toggle Button -->
    <div class="flex items-center gap-2 lg:hidden">
      <!-- Compact Viva Pill on Mobile -->
      <a href="/auth/switch-role/{{#if (eq user.role 'consumer')}}manufacturer{{else}}{{#if (eq user.role 'manufacturer')}}inspector{{else}}consumer{{/if}}{{/if}}" class="sm:hidden px-2 py-1 text-[10px] font-bold rounded bg-slate-100 border border-slate-300 text-slate-700">
        {{user.role}}
      </a>

      <button
        id="mobile-nav-toggle"
        type="button"
        aria-label="Toggle navigation menu"
        class="p-2 rounded-lg text-slate-600 hover:text-slate-900 hover:bg-slate-100 focus:outline-none focus:ring-2 focus:ring-slate-900 transition-colors"
      >
        <svg id="hamburger-icon" class="w-6 h-6" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M4 6h16M4 12h16M4 18h16"></path>
        </svg>
        <svg id="close-icon" class="w-6 h-6 hidden" fill="none" stroke="currentColor" viewBox="0 0 24 24">
          <path stroke-linecap="round" stroke-linejoin="round" stroke-width="2" d="M6 18L18 6M6 6l12 12"></path>
        </svg>
      </button>
    </div>

  </div>

  <!-- Mobile Drawer / Dropdown Panel -->
  <div id="mobile-menu" class="hidden lg:hidden border-t border-slate-200 bg-white px-4 py-4 space-y-4 shadow-lg animate-fadeIn">
    <!-- Mobile Primary Links -->
    <div class="flex flex-col space-y-1 text-sm font-bold text-slate-700">
      <a href="/" class="px-3 py-2 rounded-md hover:bg-slate-100 hover:text-slate-900 flex items-center justify-between">
        <span>Home</span>
        <span class="text-xs text-slate-400">&rarr;</span>
      </a>
      <a href="/catalog" class="px-3 py-2 rounded-md hover:bg-slate-100 hover:text-slate-900 flex items-center justify-between">
        <span>Food Catalog Discovery</span>
        <span class="text-xs text-slate-400">&rarr;</span>
      </a>
      <a href="/safety/documents" class="px-3 py-2 rounded-md hover:bg-slate-100 hover:text-slate-900 flex items-center justify-between">
        <span>Safety Documents Registry</span>
        <span class="text-xs text-slate-400">&rarr;</span>
      </a>
      <a href="/safety/licence/verify" class="px-3 py-2 rounded-md hover:bg-slate-100 hover:text-slate-900 flex items-center justify-between">
        <span>Verify Manufacturer Licence</span>
        <span class="text-xs text-slate-400">&rarr;</span>
      </a>
      {{#if user}}
        <a href="/personal/profile" class="px-3 py-2 rounded-md bg-emerald-50 text-emerald-800 hover:bg-emerald-100 flex items-center justify-between">
          <span class="flex items-center gap-2">
            <span class="w-2 h-2 rounded-full bg-emerald-600"></span>
            Dietary & Allergen Profile
          </span>
          <span class="text-xs text-emerald-600 font-bold">&rarr;</span>
        </a>
      {{/if}}
    </div>

    <!-- Mobile Role Actions -->
    {{#if (or (eq user.role "manufacturer") (eq user.role "admin"))}}
      <div class="pt-3 border-t border-slate-100 space-y-2">
        <div class="text-[11px] font-bold uppercase tracking-wider text-slate-400">Manufacturer Tools:</div>
        <div class="grid grid-cols-2 gap-2">
          <a href="/catalog/manage/create" class="px-3 py-2 text-center text-xs font-bold rounded-lg bg-emerald-700 text-white hover:bg-emerald-800">
            + Add Product
          </a>
          <a href="/safety/documents/upload" class="px-3 py-2 text-center text-xs font-bold rounded-lg border border-emerald-700 text-emerald-800 hover:bg-emerald-50">
            + Upload Cert
          </a>
        </div>
      </div>
    {{/if}}

    {{#if (eq user.role "inspector")}}
      <div class="pt-3 border-t border-slate-100 space-y-2">
        <div class="text-[11px] font-bold uppercase tracking-wider text-slate-400">Inspector Tools:</div>
        <a href="/safety/documents?status=pending" class="block px-3 py-2 text-center text-xs font-bold rounded-lg bg-amber-600 text-white hover:bg-amber-700">
          Open Audit Queue (Pending Reviews)
        </a>
      </div>
    {{/if}}

    <!-- Mobile Viva Demo Role Switcher -->
    <div class="pt-3 border-t border-slate-100">
      <div class="text-[11px] font-bold uppercase tracking-wider text-slate-400 mb-2">Switch Demo Role (Viva Evaluation):</div>
      <div class="grid grid-cols-4 gap-1.5 text-xs text-center font-bold">
        <a href="/auth/switch-role/consumer" class="py-1.5 rounded {{#if (eq user.role 'consumer')}}bg-slate-900 text-white{{else}}bg-slate-100 text-slate-700{{/if}}">Consumer</a>
        <a href="/auth/switch-role/manufacturer" class="py-1.5 rounded {{#if (eq user.role 'manufacturer')}}bg-emerald-700 text-white{{else}}bg-slate-100 text-slate-700{{/if}}">Mfg</a>
        <a href="/auth/switch-role/inspector" class="py-1.5 rounded {{#if (eq user.role 'inspector')}}bg-amber-600 text-white{{else}}bg-slate-100 text-slate-700{{/if}}">Inspector</a>
        <a href="/auth/switch-role/admin" class="py-1.5 rounded {{#if (eq user.role 'admin')}}bg-slate-900 text-white{{else}}bg-slate-100 text-slate-700{{/if}}">Admin</a>
      </div>
    </div>

    <!-- Mobile Auth -->
    <div class="pt-3 border-t border-slate-100 flex items-center justify-between">
      {{#if user}}
        <div class="flex items-center gap-2">
          <div class="w-8 h-8 rounded-full bg-slate-800 text-white flex items-center justify-center font-black text-xs uppercase">
            {{#if user.name}}{{user.name.[0]}}{{else}}U{{/if}}
          </div>
          <div>
            <div class="text-xs font-bold text-slate-900">{{user.name}}</div>
            <div class="text-[10px] text-slate-500 font-semibold uppercase">{{user.role}}</div>
          </div>
        </div>
        <form action="/auth/logout" method="POST">
          <button type="submit" class="text-xs font-bold px-3 py-1.5 rounded border border-slate-300 text-slate-700 hover:bg-slate-100">
            Sign Out
          </button>
        </form>
      {{else}}
        <a href="/auth/login" class="w-full text-center py-2.5 rounded-lg bg-slate-900 text-white font-bold text-xs">
          Sign In to TrueLabel
        </a>
      {{/if}}
    </div>
  </div>

  <!-- Vanilla JS Toggle for Mobile Navigation Drawer -->
  <script>
    (function() {
      const toggleBtn = document.getElementById('mobile-nav-toggle');
      const mobileMenu = document.getElementById('mobile-menu');
      const hamburgerIcon = document.getElementById('hamburger-icon');
      const closeIcon = document.getElementById('close-icon');

      if (toggleBtn && mobileMenu) {
        toggleBtn.addEventListener('click', function() {
          const isHidden = mobileMenu.classList.contains('hidden');
          if (isHidden) {
            mobileMenu.classList.remove('hidden');
            if (hamburgerIcon) hamburgerIcon.classList.add('hidden');
            if (closeIcon) closeIcon.classList.remove('hidden');
          } else {
            mobileMenu.classList.add('hidden');
            if (hamburgerIcon) hamburgerIcon.classList.remove('hidden');
            if (closeIcon) closeIcon.classList.add('hidden');
          }
        });
      }
    })();
  </script>
</header>
