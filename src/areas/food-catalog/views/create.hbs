<div class="max-w-3xl mx-auto my-6 bg-white p-8 border border-slate-200 rounded-lg shadow-sm">
  <div class="mb-6 pb-4 border-b border-slate-200">
    <a href="/catalog" class="text-xs font-bold text-slate-500 hover:text-slate-900">&larr; Back to Catalog</a>
    <h1 class="text-2xl font-black text-slate-900 tracking-tight mt-2">Submit Packaged Food to Catalog</h1>
    <p class="text-sm text-slate-500 mt-0.5">Manufacturers register packaged foods with verified ingredient lists and nutrition declarations.</p>
  </div>

  {{#if licenceBlocked}}
    <div class="p-6 rounded-lg bg-amber-50 border border-amber-300 text-amber-800">
      <div class="flex items-start gap-3">
        <span class="text-2xl">🔒</span>
        <div>
          <p class="font-bold text-sm mb-1">Account Not Yet Approved</p>
          <p class="text-sm">{{error}}</p>
          <div class="mt-4 flex gap-3">
            <a href="/safety/documents/upload" class="inline-block bg-amber-700 text-white text-xs font-bold px-4 py-2 rounded hover:bg-amber-800">
              Submit a Safety Document
            </a>
            <a href="/safety/documents" class="inline-block border border-amber-700 text-amber-800 text-xs font-bold px-4 py-2 rounded hover:bg-amber-100">
              View Document Status
            </a>
          </div>
        </div>
      </div>
    </div>
  {{else}}

  {{#if error}}
    <div class="mb-6 p-4 rounded bg-rose-50 border border-rose-200 text-rose-700 text-sm font-medium">
      {{error}}
    </div>
  {{/if}}

  <form action="/catalog/manage/create" method="POST" class="space-y-6">
    <input type="hidden" name="_csrf" value="{{csrfToken}}">
    
    <!-- Section 1: Basic Identity -->
    <div>
      <h2 class="text-sm font-black text-slate-900 uppercase tracking-wider mb-3">1. Basic Identification</h2>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <div>
          <label class="block text-xs font-bold uppercase text-slate-700 mb-1">Food Name *</label>
          <input
            type="text"
            name="name"
            required
            placeholder="e.g. Organic Almond Milk Unsweetened"
            value="{{productData.name}}"
            class="w-full px-3 py-2 border border-slate-300 rounded text-sm focus:outline-none focus:ring-2 focus:ring-slate-900"
          />
        </div>
        <div>
          <label class="block text-xs font-bold uppercase text-slate-700 mb-1">Brand Name *</label>
          <input
            type="text"
            name="brand"
            required
            placeholder="e.g. PureHarvest"
            value="{{productData.brand}}"
            class="w-full px-3 py-2 border border-slate-300 rounded text-sm focus:outline-none focus:ring-2 focus:ring-slate-900"
          />
        </div>
        <div>
          <label class="block text-xs font-bold uppercase text-slate-700 mb-1">Category *</label>
          <select
            name="category"
            required
            class="w-full px-3.5 py-2.5 border border-slate-300 rounded-lg text-sm font-medium focus:outline-none focus:ring-2 focus:ring-emerald-600 focus:border-transparent bg-white shadow-sm transition-all"
          >
            {{#each categories}}
              <option value="{{this}}" {{#if (eq ../productData.category this)}}selected{{/if}}>{{this}}</option>
            {{/each}}
          </select>
        </div>
        <div>
          <label class="block text-xs font-bold uppercase text-slate-700 mb-1">Barcode (EAN/UPC) *</label>
          <input
            type="text"
            name="barcode"
            required
            placeholder="e.g. 9312345678901"
            value="{{#if productData.barcode}}{{productData.barcode}}{{else}}{{barcode}}{{/if}}"
            class="w-full px-3 py-2 border border-slate-300 rounded text-sm focus:outline-none focus:ring-2 focus:ring-slate-900 font-mono"
          />
          <span class="text-[10px] text-slate-400">Must be unique across the catalog</span>
        </div>
      </div>
    </div>

    <!-- Section 2: Serving Details & Description -->
    <div class="pt-4 border-t border-slate-200">
      <h2 class="text-sm font-black text-slate-900 uppercase tracking-wider mb-3">2. Serving & Description</h2>
      <div class="grid grid-cols-1 md:grid-cols-3 gap-4">
        <div>
          <label class="block text-xs font-bold uppercase text-slate-700 mb-1">Serving Size</label>
          <input
            type="number"
            name="servingSize"
            value="{{#if productData.servingSize}}{{productData.servingSize}}{{else}}100{{/if}}"
            step="0.1"
            class="w-full px-3 py-2 border border-slate-300 rounded text-sm focus:outline-none focus:ring-2 focus:ring-slate-900"
          />
        </div>
        <div>
          <label class="block text-xs font-bold uppercase text-slate-700 mb-1">Serving Unit</label>
          <select
            name="servingUnit"
            class="w-full px-3.5 py-2.5 border border-slate-300 rounded-lg text-sm font-medium focus:outline-none focus:ring-2 focus:ring-emerald-600 focus:border-transparent bg-white shadow-sm transition-all"
          >
            <option value="g" {{#if (eq productData.servingUnit 'g')}}selected{{/if}}>Grams (g)</option>
            <option value="ml" {{#if (eq productData.servingUnit 'ml')}}selected{{/if}}>Milliliters (ml)</option>
          </select>
        </div>
        <div>
          <label class="block text-xs font-bold uppercase text-slate-700 mb-1">Dietary Tags (Comma-separated)</label>
          <input
            type="text"
            name="dietaryTags"
            placeholder="Vegan, Gluten-Free, Halal"
            value="{{productData.dietaryTags}}"
            class="w-full px-3 py-2 border border-slate-300 rounded text-sm focus:outline-none focus:ring-2 focus:ring-slate-900"
          />
        </div>
      </div>
      <div class="mt-3">
        <label class="block text-xs font-bold uppercase text-slate-700 mb-1">Product Description</label>
        <textarea
          name="description"
          rows="2"
          placeholder="Brief summary of product characteristics..."
          class="w-full px-3 py-2 border border-slate-300 rounded text-sm focus:outline-none focus:ring-2 focus:ring-slate-900"
        >{{productData.description}}</textarea>
      </div>
    </div>

    <!-- Section 3: Statutory Nutrition Facts Panel (per 100g / 100ml) -->
    <div class="pt-4 border-t border-slate-200">
      <div class="flex items-center justify-between mb-3">
        <h2 class="text-sm font-black text-slate-900 uppercase tracking-wider">3. Statutory Nutrition Facts (per 100g / 100ml)</h2>
        <span class="text-xs text-slate-500 font-medium">Standard Mandatory Food Label Declaration</span>
      </div>
      
      <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 bg-slate-50 p-4 rounded-lg border border-slate-200">
        <div>
          <label class="block text-[11px] font-bold uppercase text-slate-700 mb-1">Energy (kcal) *</label>
          <input
            type="number"
            name="nutrition_energy"
            step="0.1"
            min="0"
            required
            placeholder="e.g. 59"
            value="{{#if productData.nutrition_energy}}{{productData.nutrition_energy}}{{else}}0{{/if}}"
            class="w-full px-3 py-2 border border-slate-300 rounded text-sm bg-white font-mono focus:ring-2 focus:ring-slate-900"
          />
        </div>
        <div>
          <label class="block text-[11px] font-bold uppercase text-slate-700 mb-1">Total Fat (g)</label>
          <input
            type="number"
            name="nutrition_fat"
            step="0.1"
            min="0"
            placeholder="e.g. 3.0"
            value="{{#if productData.nutrition_fat}}{{productData.nutrition_fat}}{{else}}0{{/if}}"
            class="w-full px-3 py-2 border border-slate-300 rounded text-sm bg-white font-mono focus:ring-2 focus:ring-slate-900"
          />
        </div>
        <div>
          <label class="block text-[11px] font-bold uppercase text-slate-700 mb-1">Saturated Fat (g)</label>
          <input
            type="number"
            name="nutrition_saturatedFat"
            step="0.1"
            min="0"
            placeholder="e.g. 0.3"
            value="{{#if productData.nutrition_saturatedFat}}{{productData.nutrition_saturatedFat}}{{else}}0{{/if}}"
            class="w-full px-3 py-2 border border-slate-300 rounded text-sm bg-white font-mono focus:ring-2 focus:ring-slate-900"
          />
        </div>
        <div>
          <label class="block text-[11px] font-bold uppercase text-slate-700 mb-1">Carbohydrates (g)</label>
          <input
            type="number"
            name="nutrition_carbohydrates"
            step="0.1"
            min="0"
            placeholder="e.g. 6.6"
            value="{{#if productData.nutrition_carbohydrates}}{{productData.nutrition_carbohydrates}}{{else}}0{{/if}}"
            class="w-full px-3 py-2 border border-slate-300 rounded text-sm bg-white font-mono focus:ring-2 focus:ring-slate-900"
          />
        </div>
        <div>
          <label class="block text-[11px] font-bold uppercase text-slate-700 mb-1">Sugars (g)</label>
          <input
            type="number"
            name="nutrition_sugars"
            step="0.1"
            min="0"
            placeholder="e.g. 4.0"
            value="{{#if productData.nutrition_sugars}}{{productData.nutrition_sugars}}{{else}}0{{/if}}"
            class="w-full px-3 py-2 border border-slate-300 rounded text-sm bg-white font-mono focus:ring-2 focus:ring-slate-900"
          />
        </div>
        <div>
          <label class="block text-[11px] font-bold uppercase text-slate-700 mb-1">Dietary Fiber (g)</label>
          <input
            type="number"
            name="nutrition_fiber"
            step="0.1"
            min="0"
            placeholder="e.g. 0.8"
            value="{{#if productData.nutrition_fiber}}{{productData.nutrition_fiber}}{{else}}0{{/if}}"
            class="w-full px-3 py-2 border border-slate-300 rounded text-sm bg-white font-mono focus:ring-2 focus:ring-slate-900"
          />
        </div>
        <div>
          <label class="block text-[11px] font-bold uppercase text-slate-700 mb-1">Protein (g)</label>
          <input
            type="number"
            name="nutrition_protein"
            step="0.1"
            min="0"
            placeholder="e.g. 1.2"
            value="{{#if productData.nutrition_protein}}{{productData.nutrition_protein}}{{else}}0{{/if}}"
            class="w-full px-3 py-2 border border-slate-300 rounded text-sm bg-white font-mono focus:ring-2 focus:ring-slate-900"
          />
        </div>
        <div>
          <label class="block text-[11px] font-bold uppercase text-slate-700 mb-1">Salt / Sodium (g)</label>
          <input
            type="number"
            name="nutrition_salt"
            step="0.01"
            min="0"
            placeholder="e.g. 0.10"
            value="{{#if productData.nutrition_salt}}{{productData.nutrition_salt}}{{else}}0{{/if}}"
            class="w-full px-3 py-2 border border-slate-300 rounded text-sm bg-white font-mono focus:ring-2 focus:ring-slate-900"
          />
        </div>
      </div>
    </div>

    <!-- Section 4: Declared Ingredients & Additives -->
    <div class="pt-4 border-t border-slate-200">
      <div class="flex items-center justify-between mb-2">
        <h2 class="text-sm font-black text-slate-900 uppercase tracking-wider">4. Declared Ingredients</h2>
        <span class="text-xs text-slate-500 font-medium">Comma-separated list from packaged label</span>
      </div>
      <textarea
        name="rawIngredients"
        rows="3"
        placeholder="e.g. Oat Base (Water, Oats 10%), Rapeseed Oil, Dipotassium Phosphate (E340), Calcium Carbonate (E170), Sea Salt, Potassium Iodide"
        class="w-full px-3 py-2 border border-slate-300 rounded text-sm focus:outline-none focus:ring-2 focus:ring-slate-900 font-sans"
      >{{productData.rawIngredients}}</textarea>
      <p class="text-[11px] text-slate-400 mt-1">
        Allergens (Milk, Gluten, Peanuts, Tree Nuts, Soy, Celery) and additive E-numbers are automatically recognized and flagged for consumer safety.
      </p>
    </div>

    <button
      type="submit"
      class="w-full py-3 px-6 bg-slate-900 text-white font-bold text-sm rounded hover:bg-slate-800 transition-colors uppercase tracking-wider"
    >
      Register Product to Catalog
    </button>
  </form>
  {{/if}}
</div>

