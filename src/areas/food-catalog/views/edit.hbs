<div class="max-w-3xl mx-auto my-6 bg-white p-6 sm:p-8 border border-slate-200 rounded-xl">
  <div class="mb-6 pb-4 border-b border-slate-200 flex flex-col sm:flex-row sm:items-center justify-between gap-4">
    <div>
      <a href="/catalog/product/{{product.id}}" class="text-xs font-semibold text-slate-500 hover:text-slate-900 transition-colors">Back to food details</a>
      <h1 class="text-2xl font-black text-slate-900 tracking-tight mt-1">Edit food product</h1>
      <p class="text-xs text-slate-500 mt-0.5">Editing record for {{product.name}} (ID: #{{product.id}})</p>
    </div>
    
    <!-- Archive Action Button -->
    <form action="/catalog/manage/{{product.id}}/archive" method="POST" onsubmit="return confirm('Archive this food product? It will be hidden from catalog discovery.');">
      <input type="hidden" name="_csrf" value="{{csrfToken}}">
      <button type="submit" class="text-xs font-semibold px-3 py-1.5 rounded-md border border-rose-300 text-rose-700 hover:bg-rose-50 transition-colors">
        Archive product
      </button>
    </form>
  </div>

  {{#if error}}
    <div class="mb-6 p-4 rounded-lg bg-rose-50 border border-rose-200 text-rose-800 text-sm font-medium">
      {{error}}
    </div>
  {{/if}}

  <form action="/catalog/manage/{{product.id}}/edit" method="POST" class="space-y-6">
    <input type="hidden" name="_csrf" value="{{csrfToken}}">
    
    <!-- Section 1: Basic Identity -->
    <div class="space-y-4">
      <div>
        <h2 class="text-sm font-bold text-slate-900">Basic identification</h2>
        <p class="text-xs text-slate-500 mt-0.5">Commercial name, brand, category, and barcode</p>
      </div>
      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">
        <div>
          <label class="block text-xs font-semibold text-slate-700 mb-1">Food name *</label>
          <input
            type="text"
            name="name"
            value="{{product.name}}"
            required
            class="w-full px-3 py-2 border border-slate-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-slate-900"
          />
        </div>
        <div>
          <label class="block text-xs font-semibold text-slate-700 mb-1">Brand name *</label>
          <input
            type="text"
            name="brand"
            value="{{product.brand}}"
            required
            class="w-full px-3 py-2 border border-slate-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-slate-900"
          />
        </div>
        <div>
          <label class="block text-xs font-semibold text-slate-700 mb-1">Category *</label>
          <select
            name="category"
            required
            class="w-full px-3 py-2 border border-slate-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-slate-900 bg-white"
          >
            {{#each categories}}
              <option value="{{this}}" {{#if (eq ../product.category this)}}selected{{/if}}>{{this}}</option>
            {{/each}}
          </select>
        </div>
        <div>
          <label class="block text-xs font-semibold text-slate-700 mb-1">Barcode (EAN/UPC) *</label>
          <input
            type="text"
            name="barcode"
            value="{{product.barcode}}"
            required
            class="w-full px-3 py-2 border border-slate-300 rounded-lg text-sm font-mono focus:outline-none focus:ring-2 focus:ring-slate-900"
          />
        </div>
      </div>
    </div>

    <div>
      <label class="block text-xs font-semibold text-slate-700 mb-1">Product description</label>
      <textarea
        name="description"
        rows="3"
        class="w-full px-3 py-2 border border-slate-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-slate-900"
      >{{product.description}}</textarea>
    </div>

    <!-- Section 3: Statutory Nutrition Facts Panel (per 100g / 100ml) -->
    <div class="pt-5 border-t border-slate-200 space-y-4">
      <div>
        <h2 class="text-sm font-bold text-slate-900">Statutory nutrition facts (per 100g / 100ml)</h2>
        <p class="text-xs text-slate-500 mt-0.5">Standard mandatory food label declaration</p>
      </div>
      
      <div class="grid grid-cols-2 sm:grid-cols-4 gap-3 bg-slate-50 p-4 rounded-xl border border-slate-200">
        <div>
          <label class="block text-[11px] font-semibold text-slate-700 mb-1">Energy (kcal) *</label>
          <input
            type="number"
            name="nutrition_energy"
            step="0.1"
            min="0"
            required
            value="{{#if nutritionMap.Energy}}{{nutritionMap.Energy}}{{else}}0{{/if}}"
            class="w-full px-3 py-2 border border-slate-300 rounded-lg text-sm bg-white font-mono focus:ring-2 focus:ring-slate-900"
          />
        </div>
        <div>
          <label class="block text-[11px] font-semibold text-slate-700 mb-1">Total fat (g)</label>
          <input
            type="number"
            name="nutrition_fat"
            step="0.1"
            min="0"
            value="{{#if nutritionMap.Fat}}{{nutritionMap.Fat}}{{else}}0{{/if}}"
            class="w-full px-3 py-2 border border-slate-300 rounded-lg text-sm bg-white font-mono focus:ring-2 focus:ring-slate-900"
          />
        </div>
        <div>
          <label class="block text-[11px] font-semibold text-slate-700 mb-1">Saturated fat (g)</label>
          <input
            type="number"
            name="nutrition_saturatedFat"
            step="0.1"
            min="0"
            value="{{#if nutritionMap.SaturatedFat}}{{nutritionMap.SaturatedFat}}{{else}}0{{/if}}"
            class="w-full px-3 py-2 border border-slate-300 rounded-lg text-sm bg-white font-mono focus:ring-2 focus:ring-slate-900"
          />
        </div>
        <div>
          <label class="block text-[11px] font-semibold text-slate-700 mb-1">Carbohydrates (g)</label>
          <input
            type="number"
            name="nutrition_carbohydrates"
            step="0.1"
            min="0"
            value="{{#if nutritionMap.Carbohydrates}}{{nutritionMap.Carbohydrates}}{{else}}0{{/if}}"
            class="w-full px-3 py-2 border border-slate-300 rounded-lg text-sm bg-white font-mono focus:ring-2 focus:ring-slate-900"
          />
        </div>
        <div>
          <label class="block text-[11px] font-semibold text-slate-700 mb-1">Sugars (g)</label>
          <input
            type="number"
            name="nutrition_sugars"
            step="0.1"
            min="0"
            value="{{#if nutritionMap.Sugars}}{{nutritionMap.Sugars}}{{else}}0{{/if}}"
            class="w-full px-3 py-2 border border-slate-300 rounded-lg text-sm bg-white font-mono focus:ring-2 focus:ring-slate-900"
          />
        </div>
        <div>
          <label class="block text-[11px] font-semibold text-slate-700 mb-1">Dietary fiber (g)</label>
          <input
            type="number"
            name="nutrition_fiber"
            step="0.1"
            min="0"
            value="{{#if nutritionMap.Fiber}}{{nutritionMap.Fiber}}{{else}}0{{/if}}"
            class="w-full px-3 py-2 border border-slate-300 rounded-lg text-sm bg-white font-mono focus:ring-2 focus:ring-slate-900"
          />
        </div>
        <div>
          <label class="block text-[11px] font-semibold text-slate-700 mb-1">Protein (g)</label>
          <input
            type="number"
            name="nutrition_protein"
            step="0.1"
            min="0"
            value="{{#if nutritionMap.Protein}}{{nutritionMap.Protein}}{{else}}0{{/if}}"
            class="w-full px-3 py-2 border border-slate-300 rounded-lg text-sm bg-white font-mono focus:ring-2 focus:ring-slate-900"
          />
        </div>
        <div>
          <label class="block text-[11px] font-semibold text-slate-700 mb-1">Salt / sodium (g)</label>
          <input
            type="number"
            name="nutrition_salt"
            step="0.01"
            min="0"
            value="{{#if nutritionMap.Salt}}{{nutritionMap.Salt}}{{else}}0{{/if}}"
            class="w-full px-3 py-2 border border-slate-300 rounded-lg text-sm bg-white font-mono focus:ring-2 focus:ring-slate-900"
          />
        </div>
      </div>
    </div>

    <!-- Section 4: Declared Ingredients & Additives -->
    <div class="pt-5 border-t border-slate-200 space-y-3">
      <div>
        <h2 class="text-sm font-bold text-slate-900">Declared ingredients and additives</h2>
        <p class="text-xs text-slate-500 mt-0.5">Enter ingredients as listed on the packaged product label</p>
      </div>
      <textarea
        name="rawIngredients"
        rows="3"
        placeholder="e.g. Whole Cow Milk, Vitamin D3, Salt"
        class="w-full px-3 py-2 border border-slate-300 rounded-lg text-sm focus:outline-none focus:ring-2 focus:ring-slate-900 font-sans"
      >{{rawIngredients}}</textarea>
      <p class="text-xs text-slate-500">
        Allergens and additive E-numbers are automatically recognized and re-evaluated for the Transparency Score upon update.
      </p>
    </div>

    <div class="flex items-center gap-3 pt-4 border-t border-slate-100">
      <button
        type="submit"
        class="px-6 py-2.5 bg-slate-900 hover:bg-slate-800 text-white font-semibold text-sm rounded-lg transition-colors shadow-sm"
      >
        Update food product
      </button>
      <a href="/catalog/product/{{product.id}}" class="px-4 py-2 text-xs font-semibold text-slate-600 hover:text-slate-900 underline">
        Cancel
      </a>
    </div>
  </form>
</div>
