<div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 py-8 space-y-8">
  <!-- Header Banner -->
  <div class="bg-white border border-slate-200 rounded-2xl p-6 sm:p-8 shadow-sm flex flex-col md:flex-row md:items-center justify-between gap-6">
    <div>
      <div class="flex items-center gap-2 mb-2">
        <span class="px-2.5 py-0.5 rounded-full text-xs font-bold uppercase tracking-wider bg-slate-900 text-white">
          System Administrator
        </span>
        <span class="text-xs text-slate-400">Master Root Control</span>
      </div>
      <h1 class="text-3xl font-black text-slate-900 tracking-tight">Platform Command Center</h1>
      <p class="text-sm text-slate-500 mt-1">
        Comprehensive platform governance: user account roles, catalog transparency oversight, and regulatory audit trail monitoring.
      </p>
    </div>
    
    <div class="flex flex-wrap items-center gap-3">
      <a
        href="/catalog/manage/create"
        class="px-4 py-2.5 bg-slate-900 hover:bg-slate-800 text-white rounded-xl text-xs font-bold uppercase tracking-wider transition-all shadow-sm"
      >
        + Add Food Product
      </a>
      <a
        href="/safety/documents"
        class="px-4 py-2.5 border border-slate-300 hover:bg-slate-50 text-slate-700 rounded-xl text-xs font-bold uppercase tracking-wider transition-all"
      >
        Safety Registry
      </a>
    </div>
  </div>

  <!-- Platform Overview Grid -->
  <div class="grid grid-cols-2 sm:grid-cols-4 gap-4">
    <div class="bg-white border border-slate-200 rounded-2xl p-5 shadow-sm">
      <div class="text-xs font-bold text-slate-500 uppercase tracking-wider">Total Accounts</div>
      <div class="text-3xl font-black text-slate-900 font-mono mt-1">{{totalUsers}}</div>
      <div class="text-[11px] text-slate-400 mt-1">
        {{roleBreakdown.consumer}} Consumers · {{roleBreakdown.manufacturer}} Manufacturers
      </div>
    </div>
    <div class="bg-white border border-slate-200 rounded-2xl p-5 shadow-sm">
      <div class="text-xs font-bold text-slate-500 uppercase tracking-wider">Staff Accounts</div>
      <div class="text-3xl font-black text-amber-900 font-mono mt-1">{{roleBreakdown.inspector}}</div>
      <div class="text-[11px] text-slate-400 mt-1">
        {{roleBreakdown.inspector}} Inspectors · {{roleBreakdown.admin}} Admins
      </div>
    </div>
    <div class="bg-white border border-slate-200 rounded-2xl p-5 shadow-sm">
      <div class="text-xs font-bold text-slate-500 uppercase tracking-wider">Catalog Products</div>
      <div class="text-3xl font-black text-emerald-900 font-mono mt-1">{{totalProducts}}</div>
      <div class="text-[11px] text-slate-400 mt-1">Active packaged foods</div>
    </div>
    <div class="bg-white border border-slate-200 rounded-2xl p-5 shadow-sm">
      <div class="text-xs font-bold text-slate-500 uppercase tracking-wider">Safety Documents</div>
      <div class="text-3xl font-black text-blue-900 font-mono mt-1">{{docStats.total}}</div>
      <div class="text-[11px] text-slate-400 mt-1">{{docStats.approved}} verified accreditations</div>
    </div>
  </div>

  <!-- Registered Users Directory Table -->
  <div class="bg-white border border-slate-200 rounded-2xl shadow-sm overflow-hidden">
    <div class="p-6 border-b border-slate-200 flex items-center justify-between">
      <div>
        <h2 class="text-lg font-black text-slate-900 tracking-tight">Platform Users & Role Assignments</h2>
        <p class="text-xs text-slate-500">All registered consumer, enterprise, inspector, and administrative accounts</p>
      </div>
      <span class="text-xs font-mono font-bold text-slate-500 bg-slate-100 px-3 py-1 rounded-lg">
        {{users.length}} Accounts Registered
      </span>
    </div>

    <div class="overflow-x-auto">
      <table class="w-full text-left text-xs">
        <thead class="bg-slate-50 border-b border-slate-200 text-slate-500 font-bold uppercase tracking-wider text-[10px]">
          <tr>
            <th class="px-6 py-3">User ID</th>
            <th class="px-6 py-3">Full Name / Enterprise</th>
            <th class="px-6 py-3">Email Address</th>
            <th class="px-6 py-3">Platform Role</th>
            <th class="px-6 py-3">Status</th>
            <th class="px-6 py-3 text-right">Registration Date</th>
          </tr>
        </thead>
        <tbody class="divide-y divide-slate-100">
          {{#each users}}
            <tr class="hover:bg-slate-50/70 transition-colors">
              <td class="px-6 py-4 font-mono font-bold text-slate-400">
                #{{this.id}}
              </td>
              <td class="px-6 py-4 font-bold text-slate-900">
                {{this.name}}
              </td>
              <td class="px-6 py-4 font-mono text-slate-600">
                {{this.email}}
              </td>
              <td class="px-6 py-4">
                <span class="inline-block px-2.5 py-0.5 rounded-full text-[10px] font-bold uppercase tracking-wider {{#if (eq this.role 'consumer')}}bg-blue-100 text-blue-800{{else}}{{#if (eq this.role 'manufacturer')}}bg-emerald-100 text-emerald-800{{else}}{{#if (eq this.role 'inspector')}}bg-amber-100 text-amber-800{{else}}bg-slate-900 text-white{{/if}}{{/if}}{{/if}}">
                  {{this.role}}
                </span>
              </td>
              <td class="px-6 py-4">
                {{#if this.isVerified}}
                  <span class="text-emerald-700 font-bold text-xs">✓ Active</span>
                {{else}}
                  <span class="text-slate-400 text-xs">Unverified</span>
                {{/if}}
              </td>
              <td class="px-6 py-4 text-right font-mono text-slate-400">
                {{this.createdAt}}
              </td>
            </tr>
          {{/each}}
        </tbody>
      </table>
    </div>
  </div>
</div>
